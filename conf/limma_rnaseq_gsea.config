/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for limma-voom RNA-seq analysis with GSEA
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    limma-voom differential analysis on RNA-seq counts with GSEA functional enrichment

    Use as follows:
        nextflow run nf-core/differentialabundance -profile limma_rnaseq_gsea,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {

    config_profile_name        = 'limma-voom RNA-seq with GSEA'
    config_profile_description = 'limma-voom differential analysis on RNA-seq counts with GSEA functional enrichment'

    // Study configuration
    study_type                       = 'rnaseq'
    study_abundance_type             = 'counts'

    // Features (genes)
    features_type                    = 'gene'
    features_id_col                  = 'gene_id'
    features_name_col                = 'gene_name'
    features_metadata_cols           = 'gene_id,gene_name,gene_biotype'

    // Observations (samples)
    observations_id_col              = 'sample'
    observations_name_col            = 'sample'

    // Differential analysis method
    differential_method              = 'limma'
    limma_use_voom                   = true
    differential_file_suffix         = '.limma.results.tsv'
    differential_fc_column           = 'logFC'
    differential_pval_column         = 'P.Value'
    differential_qval_column         = 'adj.P.Val'
    differential_feature_id_column   = 'gene_id'
    differential_feature_name_column = 'gene_name'

    // Exploratory analysis
    exploratory_assay_names          = 'raw,normalised'
    exploratory_final_assay          = 'normalised'
    exploratory_log2_assays          = 'raw'

    // Functional enrichment
    functional_method                = 'gsea'
}
