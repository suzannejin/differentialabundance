/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Analysis profiles for common differential abundance workflows
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    These profiles provide pre-configured parameter sets for common analysis types.
    They implement the "single-run mode" of the dual-mode architecture.

    Use as follows:
        nextflow run nf-core/differentialabundance -profile deseq2_rnaseq_gsea,docker --input samplesheet.csv ...

    For multi-run benchmarking, use --paramsheet instead (see docs/usage.md).
----------------------------------------------------------------------------------------
*/

profiles {

    // ====================
    // DESeq2 RNA-seq profiles
    // ====================

    deseq2_rnaseq_gsea {
        params {
            config_profile_name        = 'DESeq2 RNA-seq with GSEA'
            config_profile_description = 'DESeq2 differential analysis on RNA-seq counts with GSEA functional enrichment'

            // Study configuration
            study_type                       = 'rnaseq'
            study_abundance_type             = 'counts'

            // Features (genes)
            features_type                    = 'gene'
            features_id_col                  = 'gene_id'
            features_name_col                = 'gene_name'
            features_metadata_cols           = 'gene_id,gene_name,gene_biotype'

            // Observations (samples)
            observations_id_col              = 'sample'
            observations_name_col            = 'sample'

            // Differential analysis method
            differential_method              = 'deseq2'
            differential_file_suffix         = '.deseq2.results.tsv'
            differential_fc_column           = 'log2FoldChange'
            differential_pval_column         = 'pvalue'
            differential_qval_column         = 'padj'
            differential_feature_id_column   = 'gene_id'
            differential_feature_name_column = 'gene_name'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised,variance_stabilised'
            exploratory_final_assay          = 'variance_stabilised'
            exploratory_log2_assays          = 'raw,normalised'

            // Functional enrichment
            functional_method                = 'gsea'
        }
    }

    deseq2_rnaseq_gprofiler2 {
        params {
            config_profile_name        = 'DESeq2 RNA-seq with gProfiler2'
            config_profile_description = 'DESeq2 differential analysis on RNA-seq counts with gProfiler2 functional enrichment'

            // Study configuration
            study_type                       = 'rnaseq'
            study_abundance_type             = 'counts'

            // Features (genes)
            features_type                    = 'gene'
            features_id_col                  = 'gene_id'
            features_name_col                = 'gene_name'
            features_metadata_cols           = 'gene_id,gene_name,gene_biotype'

            // Observations (samples)
            observations_id_col              = 'sample'
            observations_name_col            = 'sample'

            // Differential analysis method
            differential_method              = 'deseq2'
            differential_file_suffix         = '.deseq2.results.tsv'
            differential_fc_column           = 'log2FoldChange'
            differential_pval_column         = 'pvalue'
            differential_qval_column         = 'padj'
            differential_feature_id_column   = 'gene_id'
            differential_feature_name_column = 'gene_name'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised,variance_stabilised'
            exploratory_final_assay          = 'variance_stabilised'
            exploratory_log2_assays          = 'raw,normalised'

            // Functional enrichment
            functional_method                = 'gprofiler2'
        }
    }

    // ====================
    // limma RNA-seq profiles
    // ====================

    limma_rnaseq_gsea {
        params {
            config_profile_name        = 'limma-voom RNA-seq with GSEA'
            config_profile_description = 'limma-voom differential analysis on RNA-seq counts with GSEA functional enrichment'

            // Study configuration
            study_type                       = 'rnaseq'
            study_abundance_type             = 'counts'

            // Features (genes)
            features_type                    = 'gene'
            features_id_col                  = 'gene_id'
            features_name_col                = 'gene_name'
            features_metadata_cols           = 'gene_id,gene_name,gene_biotype'

            // Observations (samples)
            observations_id_col              = 'sample'
            observations_name_col            = 'sample'

            // Differential analysis method
            differential_method              = 'limma'
            limma_use_voom                   = true
            differential_file_suffix         = '.limma.results.tsv'
            differential_fc_column           = 'logFC'
            differential_pval_column         = 'P.Value'
            differential_qval_column         = 'adj.P.Val'
            differential_feature_id_column   = 'gene_id'
            differential_feature_name_column = 'gene_name'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised'
            exploratory_final_assay          = 'normalised'
            exploratory_log2_assays          = 'raw'

            // Functional enrichment
            functional_method                = 'gsea'
        }
    }

    limma_rnaseq_gprofiler2 {
        params {
            config_profile_name        = 'limma-voom RNA-seq with gProfiler2'
            config_profile_description = 'limma-voom differential analysis on RNA-seq counts with gProfiler2 functional enrichment'

            // Study configuration
            study_type                       = 'rnaseq'
            study_abundance_type             = 'counts'

            // Features (genes)
            features_type                    = 'gene'
            features_id_col                  = 'gene_id'
            features_name_col                = 'gene_name'
            features_metadata_cols           = 'gene_id,gene_name,gene_biotype'

            // Observations (samples)
            observations_id_col              = 'sample'
            observations_name_col            = 'sample'

            // Differential analysis method
            differential_method              = 'limma'
            limma_use_voom                   = true
            differential_file_suffix         = '.limma.results.tsv'
            differential_fc_column           = 'logFC'
            differential_pval_column         = 'P.Value'
            differential_qval_column         = 'adj.P.Val'
            differential_feature_id_column   = 'gene_id'
            differential_feature_name_column = 'gene_name'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised'
            exploratory_final_assay          = 'normalised'
            exploratory_log2_assays          = 'raw'

            // Functional enrichment
            functional_method                = 'gprofiler2'
        }
    }

    limma_rnaseq_decoupler {
        params {
            config_profile_name        = 'limma-voom RNA-seq with decoupler'
            config_profile_description = 'limma-voom differential analysis on RNA-seq counts with decoupler pathway activity inference'

            // Study configuration
            study_type                       = 'rnaseq'
            study_abundance_type             = 'counts'

            // Features (genes)
            features_type                    = 'gene'
            features_id_col                  = 'gene_id'
            features_name_col                = 'gene_name'
            features_metadata_cols           = 'gene_id,gene_name,gene_biotype'

            // Observations (samples)
            observations_id_col              = 'sample'
            observations_name_col            = 'sample'

            // Differential analysis method
            differential_method              = 'limma'
            limma_use_voom                   = true
            differential_file_suffix         = '.limma.results.tsv'
            differential_fc_column           = 'logFC'
            differential_pval_column         = 'P.Value'
            differential_qval_column         = 'adj.P.Val'
            differential_feature_id_column   = 'gene_id'
            differential_feature_name_column = 'gene_name'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised'
            exploratory_final_assay          = 'normalised'
            exploratory_log2_assays          = 'raw'

            // Functional enrichment
            functional_method                = 'decoupler'
        }
    }

    // ====================
    // dream RNA-seq profiles
    // ====================

    dream_rnaseq {
        params {
            config_profile_name        = 'dream RNA-seq'
            config_profile_description = 'dream differential analysis on RNA-seq counts with voom transformation'

            // Study configuration
            study_type                       = 'rnaseq'
            study_abundance_type             = 'counts'

            // Features (genes)
            features_type                    = 'gene'
            features_id_col                  = 'gene_id'
            features_name_col                = 'gene_name'
            features_metadata_cols           = 'gene_id,gene_name,gene_biotype'

            // Observations (samples)
            observations_id_col              = 'sample'
            observations_name_col            = 'sample'

            // Differential analysis method
            differential_method              = 'dream'
            dream_apply_voom                 = true
            differential_file_suffix         = '.dream.results.tsv'
            differential_fc_column           = 'logFC'
            differential_pval_column         = 'P.Value'
            differential_qval_column         = 'adj.P.Val'
            differential_feature_id_column   = 'gene_id'
            differential_feature_name_column = 'gene_name'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised'
            exploratory_final_assay          = 'normalised'
            exploratory_log2_assays          = 'raw'
