    // ====================
    // Affymetrix microarray profiles
    // ====================

    limma_affy {
        params {
            config_profile_name        = 'limma Affymetrix'
            config_profile_description = 'limma differential analysis for Affymetrix microarray data'

            // Study configuration
            study_type                       = 'affy_array'
            study_abundance_type             = 'intensities'

            // Features (probes)
            features_id_col                  = 'PROBEID'
            features_metadata_cols           = 'PROBEID,ENSEMBL,SYMBOL,GENETYPE'
            features_name_col                = 'SYMBOL'

            // Differential analysis method
            differential_method              = 'limma'
            differential_file_suffix         = '.limma.results.tsv'
            differential_fc_column           = 'logFC'
            differential_pval_column         = 'P.Value'
            differential_qval_column         = 'adj.P.Val'
            differential_feature_id_column   = 'PROBEID'
            differential_feature_name_column = 'SYMBOL'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised'
            exploratory_final_assay          = 'normalised'
            exploratory_log2_assays          = null

            // ShinyNGS
            shinyngs_build_app               = true
        }
    }

    limma_affy_gsea {
        params {
            config_profile_name        = 'limma Affymetrix with GSEA'
            config_profile_description = 'limma differential analysis for Affymetrix microarray data with GSEA'

            // Study configuration
            study_type                       = 'affy_array'
            study_abundance_type             = 'intensities'

            // Features (probes)
            features_id_col                  = 'PROBEID'
            features_metadata_cols           = 'PROBEID,ENSEMBL,SYMBOL,GENETYPE'
            features_name_col                = 'SYMBOL'

            // Differential analysis method
            differential_method              = 'limma'
            differential_file_suffix         = '.limma.results.tsv'
            differential_fc_column           = 'logFC'
            differential_pval_column         = 'P.Value'
            differential_qval_column         = 'adj.P.Val'
            differential_feature_id_column   = 'PROBEID'
            differential_feature_name_column = 'SYMBOL'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised'
            exploratory_final_assay          = 'normalised'
            exploratory_log2_assays          = null

            // Functional enrichment
            functional_method                = 'gsea'

            // ShinyNGS
            shinyngs_build_app               = true
        }
    }

    limma_affy_gprofiler2 {
        params {
            config_profile_name        = 'limma Affymetrix with gProfiler2'
            config_profile_description = 'limma differential analysis for Affymetrix microarray data with gProfiler2'

            // Study configuration
            study_type                       = 'affy_array'
            study_abundance_type             = 'intensities'

            // Features (probes)
            features_id_col                  = 'PROBEID'
            features_metadata_cols           = 'PROBEID,ENSEMBL,SYMBOL,GENETYPE'
            features_name_col                = 'SYMBOL'

            // Differential analysis method
            differential_method              = 'limma'
            differential_file_suffix         = '.limma.results.tsv'
            differential_fc_column           = 'logFC'
            differential_pval_column         = 'P.Value'
            differential_qval_column         = 'adj.P.Val'
            differential_feature_id_column   = 'PROBEID'
            differential_feature_name_column = 'SYMBOL'

            // Exploratory analysis
            exploratory_assay_names          = 'raw,normalised'
            exploratory_final_assay          = 'normalised'
            exploratory_log2_assays          = null

            // Functional enrichment
            functional_method                = 'gprofiler2'

            // ShinyNGS
            shinyngs_build_app               = true
